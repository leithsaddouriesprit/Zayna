<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.SuiviCandidatureController"
      styleClass="suivi-candidature"
      spacing="16" alignment="CENTER_LEFT">
    <stylesheets>
        <URL value="@/leith/Parent-home.css"/>
        <URL value="@/leith/chauffeur-module.css"/>
    </stylesheets>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Suivi Candidature" styleClass="title-label"/>
    <Label fx:id="lblNomPrenom" text="Nom, Prénom" styleClass="field-label"/>
    <Label fx:id="lblStatut" text="Statut" styleClass="field-label"/>
    <Label fx:id="lblDateEnvoi" text="Date envoi" styleClass="field-label"/>
    <Label fx:id="lblMaladie" text="Maladie" styleClass="field-label"/>
    <StackPane styleClass="permis-preview">
        <ImageView fx:id="imgPermisPreview" fitWidth="120" fitHeight="80" preserveRatio="true" visible="false"/>
    </StackPane>

    <HBox styleClass="button-bar" spacing="12">
        <Button fx:id="btnAnnuler" text="Annuler" onAction="#onAnnuler" visible="false"/>
        <Button fx:id="btnPostulerAnouveau" text="Postuler à nouveau" onAction="#onPostulerAnouveau" visible="false"/>
        <Button fx:id="btnAllerEspace" text="Aller à Espace Chauffeur" onAction="#onAllerEspace" visible="false"/>
    </HBox>

    <Label fx:id="lblMessage" text="" wrapText="true"/>

</VBox>
