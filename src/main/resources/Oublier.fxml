<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- CORRECTION 1: SUPPRIMER LA VERSION DES xmlns -->
<StackPane style="-fx-background-color: linear-gradient(to bottom, #667eea, #764ba2);"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.esprit.workshop.controlleurs.talel.OublierController">

    <!-- CORRECTION 2: SUPPRIMER LE PADDING ICI (il est déjà dans la VBox) -->
    <VBox alignment="CENTER" maxWidth="500" spacing="20">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-size: 60px;" text="🚌" />
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Zayna" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="Récupération de mot de passe" />
        </VBox>

        <!-- Carte principale -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-spacing: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);" maxWidth="400">

            <!-- Message global -->
            <Label fx:id="messageLabel" wrapText="true" managed="true" visible="false"
                   style="-fx-padding: 10; -fx-background-radius: 5; -fx-font-size: 13px;" />

            <!-- Indicateur de chargement -->
            <StackPane>
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="30" maxWidth="30" visible="false" />
            </StackPane>

            <!-- ÉTAPE 1: Demande d'email -->
            <VBox fx:id="emailStep" spacing="15" visible="true" managed="true">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Mot de passe oublié ?" />
                <Label style="-fx-text-fill: #718096; -fx-font-size: 13px;" text="Saisissez votre email pour recevoir un code de vérification" wrapText="true" />

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 13px;" text="Email" />
                    <TextField fx:id="emailField" promptText="votre@email.com"
                               style="-fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-padding: 10; -fx-font-size: 14px;" />
                </VBox>

                <Button fx:id="sendCodeButton" onAction="#handleSendCode" text="ENVOYER LE CODE"
                        maxWidth="Infinity" prefHeight="40"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 14px;" />
            </VBox>

            <!-- ÉTAPE 2: Vérification du code -->
            <VBox fx:id="codeStep" spacing="15" visible="false" managed="false">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Vérification" />
                <Label fx:id="userTypeLabel" style="-fx-text-fill: #667eea; -fx-font-weight: bold; -fx-font-size: 13px;" />
                <Label style="-fx-text-fill: #718096; -fx-font-size: 13px;" text="Entrez le code à 6 chiffres envoyé à votre email" wrapText="true" />

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 13px;" text="Code de vérification" />
                    <TextField fx:id="codeField" promptText="000000"
                               style="-fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-padding: 10; -fx-font-size: 18px; -fx-alignment: center; -fx-font-family: monospace;" />
                </VBox>

                <Label fx:id="timerLabel" style="-fx-text-fill: #718096; -fx-alignment: center; -fx-font-size: 13px;" text="⏱️ Code valable : 5:00" />

                <Button fx:id="verifyCodeButton" onAction="#handleVerifyCode" text="VÉRIFIER LE CODE"
                        maxWidth="Infinity" prefHeight="40"
                        style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 14px;" />

                <HBox alignment="CENTER" spacing="5">
                    <Label style="-fx-text-fill: #718096; -fx-font-size: 13px;" text="Code non reçu ?" />
                    <Hyperlink onAction="#handleResendCode" style="-fx-text-fill: #667eea; -fx-font-weight: bold; -fx-font-size: 13px;" text="Renvoyer" />
                </HBox>
            </VBox>

            <!-- ÉTAPE 3: Nouveau mot de passe -->
            <VBox fx:id="newPasswordStep" spacing="15" visible="false" managed="false">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Nouveau mot de passe" />

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 13px;" text="Nouveau mot de passe" />
                    <PasswordField fx:id="newPasswordField" promptText="••••••••"
                                   style="-fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-padding: 10; -fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 13px;" text="Confirmer le mot de passe" />
                    <PasswordField fx:id="confirmPasswordField" promptText="••••••••"
                                   style="-fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-padding: 10; -fx-font-size: 14px;" />
                </VBox>

                <Label style="-fx-text-fill: #718096; -fx-font-size: 11px;" text="Le mot de passe doit contenir au moins 6 caractères, une majuscule et un chiffre" wrapText="true" />

                <Button fx:id="resetPasswordButton" onAction="#handleResetPassword" text="RÉINITIALISER"
                        maxWidth="Infinity" prefHeight="40"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 14px;" />
            </VBox>

            <!-- ÉTAPE 4: Succès -->
            <VBox fx:id="successStep" spacing="15" visible="false" managed="false" alignment="CENTER">
                <Label style="-fx-font-size: 60px;" text="✅" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #48bb78;" text="Mot de passe modifié !" />
                <Label style="-fx-text-fill: #718096; -fx-font-size: 14px;" text="Votre mot de passe a été réinitialisé avec succès" wrapText="true" alignment="CENTER" />
                <Label style="-fx-text-fill: #718096; -fx-font-size: 13px;" text="Redirection vers la connexion..." />
            </VBox>

            <!-- Séparateur -->
            <Region style="-fx-pref-height: 1; -fx-background-color: #e2e8f0; -fx-margin: 10 0;" />

            <!-- Retour -->
            <Hyperlink onAction="#handleBackToLogin" style="-fx-text-fill: #718096; -fx-alignment: CENTER; -fx-font-size: 13px;" text="← Retour à la connexion" />
        </VBox>
    </VBox>
</StackPane>