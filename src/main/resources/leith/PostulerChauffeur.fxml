<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.leith.PostulerChauffeurController">

    <children>
        <VBox spacing="14.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Candidature Chauffeur" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="140" prefWidth="160"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Nom -->
                <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfNom" promptText="Entrez votre nom"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Prénom -->
                <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPrenom" promptText="Entrez votre prénom"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Age -->
                <Label text="Âge :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Spinner fx:id="spAge" editable="true"
                         GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Expérience -->
                <Label text="Années d'expérience :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="spExperience" editable="true"
                         GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Maladie (non stockée) -->
                <Label text="Maladie affectant le travail ?" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ChoiceBox fx:id="cbMaladie"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnEnvoyer"
                        text="Envoyer candidature"
                        onAction="#envoyerCandidature"/>
            </HBox>


            <Label fx:id="lblMessage"
                   text=""
                   wrapText="true"
                   style="-fx-font-size: 13px;"/>

        </VBox>
    </children>
</AnchorPane>
