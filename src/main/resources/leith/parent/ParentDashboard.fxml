<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.parent.ParentDashboardController"
      spacing="18" alignment="TOP_LEFT" styleClass="content-area admin-main-panel parent-page">
    <stylesheets>
        <URL value="@../design/global.css"/>
    </stylesheets>
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <VBox spacing="18" styleClass="parent-home-main-panel parent-home-frame" fillWidth="true" VBox.vgrow="ALWAYS"
          style="-fx-background-color: linear-gradient(to bottom right, #181818, #101010); -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.30); -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;">
        <GridPane hgap="18" vgap="18" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="parent-home-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="45" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="27.5" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="27.5" hgrow="ALWAYS"/>
            </columnConstraints>

            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="8" styleClass="parent-home-card parent-home-card-welcome" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to bottom right, #454545, #3A3A3A); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.38); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <Label text="Bienvenue" styleClass="parent-card-title"/>
                <Label fx:id="lblWelcome" wrapText="true" styleClass="parent-card-text"/>
            </VBox>

            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="8" styleClass="parent-home-card parent-home-card-weather" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to bottom right, #454545, #3A3A3A); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.38); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <Label text="Météo" styleClass="parent-card-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblWeatherIcon" styleClass="parent-weather-icon"/>
                    <VBox spacing="2">
                        <Label fx:id="lblWeatherTemp" styleClass="parent-weather-temp"/>
                        <Label fx:id="lblWeatherStatus" wrapText="true" styleClass="parent-card-text"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="8" styleClass="parent-home-card parent-home-card-tip" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to bottom right, #454545, #3A3A3A); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.38); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <Label text="Conseil du jour" styleClass="parent-card-title"/>
                <Label fx:id="lblTip" wrapText="true" styleClass="parent-card-text"/>
            </VBox>

            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3" spacing="10" styleClass="parent-home-card parent-home-card-safety" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to bottom right, #3F3F3F, #343434); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.38); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 22;">
                <Label text="Sécurité &amp; confiance" styleClass="parent-card-title"/>
                <Label text="• Transport encadré par des professionnels" wrapText="true" styleClass="parent-card-text"/>
                <Label text="• Suivi du bus en temps réel disponible" wrapText="true" styleClass="parent-card-text"/>
                <Label text="• Espace parent sécurisé pour vos démarches" wrapText="true" styleClass="parent-card-text"/>
            </VBox>

            <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="3" spacing="6" styleClass="parent-home-card parent-home-card-highlight" alignment="CENTER" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to bottom right, #404040, #353535); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.38); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 18;">
                <Label text="🚌" styleClass="parent-illustration-icon"/>
                <Label text="Un trajet serein vers l'école" wrapText="true" styleClass="parent-card-text" alignment="CENTER"/>
            </VBox>
        </GridPane>
    </VBox>
</VBox>
