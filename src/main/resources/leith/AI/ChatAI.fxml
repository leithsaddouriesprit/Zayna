<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.leith.AI.ChatAIController"
            stylesheets="/leith/AI/chat-ai.css"
            styleClass="chat-root">

    <top>
        <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>
            <Label text="ZAYNA" styleClass="chat-header-title"/>
            <Label text="Assistant IA" styleClass="chat-header-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour" styleClass="chat-btn-back" onAction="#goBack"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="chat-body" VBox.vgrow="ALWAYS">
            <TextArea fx:id="taChat" styleClass="chat-messages" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="chat-footer" alignment="CENTER" spacing="12">
            <padding>
                <Insets top="16" right="20" bottom="20" left="20"/>
            </padding>
            <TextField fx:id="tfMessage" styleClass="chat-input ai-input" promptText="Écrire un message..." HBox.hgrow="ALWAYS" onAction="#send"/>
            <Button fx:id="btnSend" text="Envoyer" styleClass="chat-btn-send" onAction="#send"/>
        </HBox>
    </bottom>

</BorderPane>
