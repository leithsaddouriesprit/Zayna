<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.ChauffeurHomeController"
      styleClass="chauffeur-home content-area admin-main-panel chauffeur-page"
      spacing="16" alignment="TOP_LEFT">
    <stylesheets>
        <URL value="@/leith/design/global.css"/>
    </stylesheets>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Accueil Chauffeur" styleClass="admin-page-title"/>
    <Label text="Choisissez une action pour gérer votre parcours." styleClass="admin-page-subtitle" style="-fx-text-fill: #f1c40f;"/>

    <VBox spacing="16" styleClass="admin-section-panel chauffeur-home-panel" VBox.vgrow="ALWAYS">
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="chauffeur-home-cards-row">
            <VBox spacing="8" styleClass="chauffeur-home-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Postuler" styleClass="admin-stat-card-title"/>
                <Label text="Envoyez votre candidature chauffeur." wrapText="true" styleClass="section-subtitle"/>
                <Button fx:id="btnPostuler" text="Postuler" onAction="#onPostuler" styleClass="btn-primary"/>
            </VBox>
            <VBox spacing="8" styleClass="chauffeur-home-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Suivi candidature" styleClass="admin-stat-card-title"/>
                <Label text="Consultez le statut de votre demande." wrapText="true" styleClass="section-subtitle"/>
                <Button fx:id="btnSuivi" text="Suivi candidature" onAction="#onSuiviCandidature" styleClass="btn-secondary"/>
            </VBox>
            <VBox spacing="8" styleClass="chauffeur-home-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Espace Chauffeur" styleClass="admin-stat-card-title"/>
                <Label text="Accédez à vos informations validées." wrapText="true" styleClass="section-subtitle"/>
                <Button fx:id="btnEspace" text="Espace Chauffeur" onAction="#onEspaceChauffeur" styleClass="btn-soft"/>
            </VBox>
        </HBox>

        <VBox spacing="8" styleClass="chauffeur-home-card chauffeur-home-note" maxWidth="Infinity">
            <Label text="Conseil" styleClass="admin-stat-card-title"/>
            <Label text="Gardez vos documents à jour pour accélérer la validation de votre dossier." wrapText="true" styleClass="section-subtitle"/>
        </VBox>
    </VBox>
</VBox>
