<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.parent.ParentDemandeTransportController"
      styleClass="content-area admin-main-panel parent-page" spacing="14">
    <stylesheets><URL value="@../design/global.css"/></stylesheets>
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Demande de transport scolaire" styleClass="admin-page-title"/>
    <Label text="Renseignez les informations de l'enfant pour envoyer une candidature." styleClass="admin-page-subtitle" style="-fx-text-fill: #f1c40f;"/>

    <VBox spacing="12" styleClass="admin-section-panel parent-section-panel" VBox.vgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="École:" styleClass="field-label"/>
            <ComboBox fx:id="comboEcole" prefWidth="320" promptText="Choisir une école"/>
        </HBox>

        <Label text="Enfant" styleClass="admin-stat-card-title"/>
        <GridPane hgap="10" vgap="10">
            <Label text="Nom:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="tfNom" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="240"/>
            <Label text="Prénom:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="tfPrenom" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="240"/>
            <Label text="Âge:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Spinner fx:id="spAge" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="110"/>
        </GridPane>

        <Label text="Adresse (coordonnées)" styleClass="admin-stat-card-title"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Latitude:" styleClass="field-label"/>
            <TextField fx:id="tfLat" prefWidth="150"/>
            <Label text="Longitude:" styleClass="field-label"/>
            <TextField fx:id="tfLng" prefWidth="150"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Envoyer la demande" onAction="#envoyer" styleClass="btn-primary"/>
            <Label fx:id="lblMessage" text="" wrapText="true" styleClass="section-subtitle"/>
        </HBox>
    </VBox>
</VBox>
