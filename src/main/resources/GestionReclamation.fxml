<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.GestionReclamationController"
            style="-fx-background-color: #f0f4f8;">

    <children>
        <!-- Barre latérale gauche - Plus claire -->
        <VBox spacing="30"
              style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f0f4f8); -fx-padding: 30 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;"
              prefWidth="280"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0">

            <!-- Logo et titre -->
            <VBox spacing="15" alignment="CENTER">
                <StackPane>
                    <Circle radius="40" fill="linear-gradient(to bottom right, #3b82f6, #8b5cf6)"/>
                    <Label text="📋" style="-fx-font-size: 40px; -fx-text-fill: white;"/>
                </StackPane>
                <Label text="ReclaimMaster"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-family: 'Segoe UI';"/>
                <Label text="Gestion intelligente"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <!-- Stats rapides -->
            <VBox spacing="15" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="TABLEAU DE BORD" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane>
                        <Circle radius="20" fill="rgba(59,130,246,0.1)"/>
                        <Label text="📊" style="-fx-font-size: 18px; -fx-text-fill: #1e293b;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Total" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="totalReclamations" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane>
                        <Circle radius="20" fill="rgba(245,158,11,0.1)"/>
                        <Label text="⏳" style="-fx-font-size: 18px; -fx-text-fill: #1e293b;"/>
                    </StackPane>
                    <VBox>
                        <Label text="En attente" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="enAttenteCount" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane>
                        <Circle radius="20" fill="rgba(34,197,94,0.1)"/>
                        <Label text="✅" style="-fx-font-size: 18px; -fx-text-fill: #1e293b;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Traitées" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="traiteesCount" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Menu navigation -->
            <VBox spacing="10">
                <Label text="MENU" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-letter-spacing: 1px; -fx-padding: 0 0 0 10;"/>

                <Button text="🏠 Accueil" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="📝 Nouvelle" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-background-radius: 12; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;"/>
                <Button text="📊 Statistiques" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-background-radius: 12; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;"/>
                <Button text="⚙️ Paramètres" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-background-radius: 12; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Profil utilisateur -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <StackPane>
                    <Circle radius="25" fill="linear-gradient(to bottom right, #3b82f6, #8b5cf6)"/>
                    <Label text="👤" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                </StackPane>
                <VBox>
                    <Label text="Utilisateur #1" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label text="Connecté" style="-fx-font-size: 11px; -fx-text-fill: #22c55e;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Contenu principal -->
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="280"
                    AnchorPane.rightAnchor="0">

            <VBox spacing="25" style="-fx-padding: 30;">

                <!-- En-tête avec recherche -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox>
                        <Label text="Bienvenue, 👋" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Label text="Gestion des Réclamations"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-family: 'Segoe UI';"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Barre de recherche intégrée -->
                    <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                        <TextField fx:id="searchField"
                                   promptText="Rechercher..."
                                   style="-fx-background-radius: 30; -fx-border-radius: 30; -fx-padding: 12 20; -fx-border-color: transparent; -fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-font-size: 14px;"
                                   prefWidth="300"/>
                        <Button text="🔍 Rechercher"
                                onAction="#rechercherReclamation"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 10 25; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>
                    </HBox>
                </HBox>

                <!-- Formulaire de réclamation -->
                <VBox spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-border-color: #e2e8f0; -fx-border-radius: 30; -fx-border-width: 1;">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane>
                            <Circle radius="25" fill="linear-gradient(to bottom right, #3b82f6, #8b5cf6)"/>
                            <Label text="✏️" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                        </StackPane>
                        <Label text="Créer une nouvelle réclamation"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-family: 'Segoe UI';"/>
                    </HBox>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- Type -->
                        <Label text="Type"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 14px;"/>
                        <ChoiceBox fx:id="typeChoice"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"
                                   prefWidth="300"
                                   style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-padding: 8 15; -fx-font-size: 14px;"/>

                        <!-- Message -->
                        <Label text="Message"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 14px;"/>
                        <TextArea fx:id="messageField"
                                  GridPane.rowIndex="1"
                                  GridPane.columnIndex="1"
                                  prefRowCount="4"
                                  wrapText="true"
                                  promptText="Décrivez votre réclamation..."
                                  style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 12; -fx-font-size: 14px;"/>

                        <!-- Détails spécifiques -->
                        <Label text="Détails"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 14px;"/>

                        <StackPane GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"
                                   prefHeight="160"
                                   style="-fx-background-color: #f8fafc; -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 15;">

                            <!-- Panel Chauffeur -->
                            <VBox fx:id="panelChauffeur" spacing="12" managed="false" visible="false">
                                <Label text="Nom du chauffeur :" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <TextField fx:id="chauffeurNomField" promptText="Nom du chauffeur"
                                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10;"/>
                                <Label text="Prénom du chauffeur :" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <TextField fx:id="chauffeurPrenomField" promptText="Prénom du chauffeur"
                                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10;"/>
                            </VBox>

                            <!-- Panel Bus -->
                            <VBox fx:id="panelBus" spacing="12" managed="false" visible="false">
                                <Label text="Matricule du bus :" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <TextField fx:id="busMatriculeField" promptText="Matricule du bus"
                                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10;"/>
                            </VBox>

                            <!-- Panel Cantine -->
                            <VBox fx:id="panelCantine" spacing="12" managed="false" visible="false">
                                <Label text="Type de problème :" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <ChoiceBox fx:id="cantineTypeChoice" prefWidth="300"
                                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-padding: 8 15;"/>
                            </VBox>

                            <!-- Panel École -->
                            <VBox fx:id="panelEcole" spacing="12" managed="false" visible="false">
                                <Label text="Nom de l'école :" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <TextField fx:id="ecoleNomField" promptText="Nom de l'école"
                                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10;"/>
                            </VBox>

                            <!-- Panel Autre -->
                            <VBox fx:id="panelAutre" spacing="12" managed="false" visible="false">
                                <Label text="Précision :" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <TextField fx:id="autrePrecisionField" promptText="Précision"
                                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10;"/>
                            </VBox>

                            <!-- Panel Trajet -->
                            <VBox fx:id="panelTrajet" spacing="12" managed="false" visible="false" alignment="CENTER">
                                <Label text="✓ Aucun détail requis"
                                       style="-fx-font-size: 14px; -fx-text-fill: #22c55e; -fx-font-weight: bold; -fx-padding: 30 0;"/>
                            </VBox>
                        </StackPane>

                        <!-- Section Traduction -->
                        <Label text="Traduction"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 14px;"/>

                        <VBox GridPane.rowIndex="3"
                              GridPane.columnIndex="1"
                              spacing="12">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <ChoiceBox fx:id="langueCibleChoice" prefWidth="200"
                                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #8b5cf6; -fx-background-color: white; -fx-text-fill: #1e293b; -fx-padding: 8 15;"/>
                                <Label text="Langue cible"
                                       style="-fx-text-fill: #8b5cf6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #f3e8ff; -fx-background-radius: 15; -fx-padding: 5 12;"/>
                            </HBox>
                            <Label fx:id="traductionLabel"
                                   text="Cliquez sur Traduire"
                                   wrapText="true"
                                   style="-fx-text-fill: #1e293b; -fx-font-style: italic; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;"/>
                        </VBox>
                    </GridPane>

                    <!-- Barre d'outils -->
                    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                        <Button text="🌐 Traduire"
                                onAction="#traduireMessage"
                                style="-fx-background-color: linear-gradient(to right, #8b5cf6, #3b82f6); -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12 25; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 15, 0, 0, 2);"/>
                        <Button text="🗑️ Vider"
                                onAction="#viderFormulaire"
                                style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12 25; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
                        <Button text="📤 Envoyer"
                                onAction="#envoyerReclamation"
                                style="-fx-background-color: linear-gradient(to right, #22c55e, #16a34a); -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(34,197,94,0.3), 15, 0, 0, 2);"/>
                        <Button text="✏️ Modifier"
                                onAction="#modifierReclamation"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12 25; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
                        <Button text="❌ Supprimer"
                                onAction="#supprimerReclamation"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12 25; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Message de statut -->
                <Label fx:id="statusLabel"
                       text=""
                       wrapText="true"
                       style="-fx-font-size: 13px; -fx-padding: 12 20; -fx-background-color: white; -fx-background-radius: 30; -fx-text-fill: #1e293b; -fx-border-color: #e2e8f0; -fx-border-radius: 30; -fx-border-width: 1;"/>

                <!-- Liste des réclamations -->
                <VBox spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-border-color: #e2e8f0; -fx-border-radius: 30; -fx-border-width: 1;">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane>
                            <Circle radius="20" fill="linear-gradient(to bottom right, #3b82f6, #8b5cf6)"/>
                            <Label text="📋" style="-fx-font-size: 20px; -fx-text-fill: white;"/>
                        </StackPane>
                        <Label text="Mes réclamations"
                               style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #1e293b;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="compteurReclamations"
                               text="0 réclamation(s)"
                               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-background-color: #3b82f6; -fx-background-radius: 20; -fx-padding: 5 15; -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="tableReclamation"
                               prefHeight="300"
                               minHeight="200"
                               style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15;">
                        <columns>
                            <TableColumn fx:id="colType" text="Type" prefWidth="100" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colDescription" text="Message" prefWidth="250"/>
                            <TableColumn fx:id="colDetails" text="Détails" prefWidth="150"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="130" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- SECTION REPONSE ADMIN -->
                <VBox spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 25; -fx-border-color: #8b5cf6; -fx-border-width: 2; -fx-border-radius: 30; -fx-effect: dropshadow(gaussian, rgba(139,92,246,0.2), 15, 0, 0, 2);">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <StackPane>
                            <Circle radius="25" fill="linear-gradient(to bottom right, #8b5cf6, #3b82f6)"/>
                            <Label text="👤" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                        </StackPane>
                        <VBox>
                            <Label text="Réponse administration"
                                   style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;"/>
                            <Label text="L'équipe vous répondra rapidement"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        </VBox>
                    </HBox>

                    <TextArea fx:id="reponseArea"
                              editable="false"
                              prefRowCount="4"
                              wrapText="true"
                              promptText="Aucune réponse..."
                              style="-fx-background-color: #f8fafc; -fx-background-radius: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 15; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 12; -fx-font-size: 14px;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Circle radius="8" fill="#f59e0b"/>
                        <Label text="Statut :" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Label fx:id="statutReponseLabel"
                               text="En attente"
                               style="-fx-text-fill: #f59e0b; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="traduireReponseButton"
                                text="🌐 Traduire"
                                onAction="#traduireReponse"
                                disable="true"
                                style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="traductionReponseLabel"
                           text=""
                           wrapText="true"
                           style="-fx-text-fill: #64748b; -fx-font-style: italic; -fx-font-size: 13px; -fx-padding: 5 0 0 0;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </children>
</AnchorPane>