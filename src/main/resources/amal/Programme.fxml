<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.amal.ProgrammeController"
      spacing="20" alignment="TOP_CENTER"
      style="
          -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea 0%, #764ba2 50%, #6b8cff 100%);
          -fx-background-radius: 30px;
          -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.25), 30, 0, 0, 15);
          -fx-padding: 25px;
          -fx-max-width: 1000px;
          -fx-font-family: 'Segoe UI', 'Arial', sans-serif;
      ">

    <style>
        /* ===== STYLE GLOBAL ===== */
        * {
        -fx-transition: all 0.3s ease;
        }

        /* ===== CONTENEUR PRINCIPAL ===== */
        .main-container {
        -fx-background-color: rgba(255, 255, 255, 0.95);
        -fx-background-radius: 25px;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.15), 20, 0, 0, 5);
        -fx-padding: 25px;
        }

        /* ===== EN-TÊTE ===== */
        .header {
        -fx-padding: 0 0 15px 0;
        -fx-border-width: 0 0 2px 0;
        -fx-border-color: linear-gradient(from 0% 0% to 100% 100%, #667eea 0%, #764ba2 100%);
        -fx-border-insets: 0 0 15px 0;
        }

        .titre-principal {
        -fx-font-size: 32px;
        -fx-font-weight: bold;
        -fx-text-fill: #4a5568;
        -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.3), 10, 0, 0, 2);
        }

        .titre-principal:hover {
        -fx-scale-x: 1.02;
        -fx-scale-y: 1.02;
        }

        /* ===== BOUTON FERMETURE ===== */
        .close-button {
        -fx-background-color: transparent;
        -fx-background-radius: 50%;
        -fx-padding: 5px;
        -fx-min-width: 30px;
        -fx-min-height: 30px;
        -fx-max-width: 30px;
        -fx-max-height: 30px;
        -fx-cursor: hand;
        -fx-effect: none;
        }

        .close-button:hover {
        -fx-background-color: rgba(255, 99, 71, 0.1);
        -fx-scale-x: 1.1;
        -fx-scale-y: 1.1;
        }

        .close-button:pressed {
        -fx-scale-x: 0.95;
        -fx-scale-y: 0.95;
        }

        /* ===== CHAMPS DE FORMULAIRE ===== */
        .form-grid {
        -fx-padding: 10px 0;
        }

        .field-container {
        -fx-padding: 3px 0;
        }

        .custom-field, .custom-area {
        -fx-background-color: white;
        -fx-border-color: #e2e8f0;
        -fx-border-width: 2px;
        -fx-border-radius: 12px;
        -fx-background-radius: 12px;
        -fx-padding: 10px 15px;
        -fx-font-size: 14px;
        -fx-prompt-text-fill: #a0aec0;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.03), 5, 0, 0, 2);
        }

        .custom-field {
        -fx-min-width: 280px;
        -fx-max-width: 280px;
        }

        .custom-field:hover, .custom-area:hover {
        -fx-border-color: #667eea;
        -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.2), 10, 0, 0, 3);
        }

        .custom-field:focused, .custom-area:focused {
        -fx-border-color: #764ba2;
        -fx-effect: dropshadow(gaussian, rgba(118, 75, 162, 0.3), 15, 0, 0, 4);
        }

        .custom-area {
        -fx-min-height: 80px;
        -fx-min-width: 600px;
        }

        /* ===== BOUTONS D'ACTION FINS ===== */
        .boutons-container {
        -fx-spacing: 15px;
        -fx-alignment: center;
        -fx-padding: 10px 0;
        }

        .button-action {
        -fx-background-radius: 8px;
        -fx-padding: 8px 18px;
        -fx-font-size: 14px;
        -fx-font-weight: bold;
        -fx-cursor: hand;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.1), 5, 0, 0, 2);
        -fx-min-width: 100px;
        -fx-alignment: center;
        -fx-spacing: 8px;
        }

        .button-action:hover {
        -fx-scale-x: 1.05;
        -fx-scale-y: 1.05;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.2), 10, 0, 0, 4);
        }

        .button-action:pressed {
        -fx-scale-x: 0.98;
        -fx-scale-y: 0.98;
        }

        .button-ajouter {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #48bb78 0%, #38a169 100%);
        -fx-text-fill: white;
        }

        .button-modifier {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ed8936 0%, #dd6b20 100%);
        -fx-text-fill: white;
        }

        .button-supprimer {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f56565 0%, #e53e3e 100%);
        -fx-text-fill: white;
        }

        /* ===== PANNEAU D'INFORMATION ===== */
        .info-panel {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #fefcbf 0%, #faf089 100%);
        -fx-background-radius: 12px;
        -fx-padding: 10px 15px;
        -fx-border-color: #ecc94b;
        -fx-border-width: 1px;
        -fx-border-radius: 12px;
        -fx-effect: dropshadow(gaussian, rgba(236, 201, 75, 0.2), 8, 0, 0, 2);
        }

        .info-text {
        -fx-text-fill: #744210;
        -fx-font-weight: 500;
        -fx-font-size: 13px;
        }

        .badge {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #48bb78 0%, #38a169 100%);
        -fx-background-radius: 20px;
        -fx-padding: 4px 12px;
        -fx-text-fill: white;
        -fx-font-weight: bold;
        -fx-font-size: 12px;
        }

        /* ===== TABLEVIEW ===== */
        .custom-table {
        -fx-background-color: transparent;
        -fx-border-color: rgba(226, 232, 240, 0.5);
        -fx-border-width: 1px;
        -fx-border-radius: 15px;
        -fx-background-radius: 15px;
        -fx-padding: 5px;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.08), 15, 0, 0, 3);
        }

        .custom-table .column-header-background {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea 0%, #764ba2 100%);
        -fx-background-radius: 15px 15px 0 0;
        -fx-padding: 10px 0;
        }

        .custom-table .column-header, .custom-table .filler {
        -fx-background-color: transparent;
        -fx-border-color: transparent;
        }

        .custom-table .column-header .label {
        -fx-font-size: 14px;
        -fx-font-weight: bold;
        -fx-text-fill: white;
        -fx-alignment: center;
        }

        .custom-table .table-row-cell {
        -fx-background-color: white;
        -fx-border-color: transparent transparent #edf2f7 transparent;
        -fx-border-width: 0 0 1px 0;
        }

        .custom-table .table-row-cell:odd {
        -fx-background-color: #f7fafc;
        }

        .custom-table .table-row-cell:hover {
        -fx-background-color: #e6fffa;
        -fx-scale-x: 1.01;
        -fx-scale-y: 1.01;
        }

        .custom-table .table-row-cell:selected {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #c3dafe 0%, #e9d8fd 100%);
        }

        .custom-table .table-cell {
        -fx-padding: 10px 8px;
        -fx-font-size: 13px;
        -fx-text-fill: #2d3748;
        -fx-alignment: center;
        }

        /* ===== SCROLLBAR ===== */
        .scroll-bar:vertical {
        -fx-background-color: transparent;
        -fx-background-radius: 10px;
        -fx-padding: 5px;
        }

        .scroll-bar:vertical .thumb {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #cbd5e0 0%, #a0aec0 100%);
        -fx-background-radius: 10px;
        }

        .scroll-bar:vertical .thumb:hover {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #a0aec0 0%, #718096 100%);
        }

        /* ===== PIED DE PAGE ===== */
        .footer {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f7fafc 0%, #edf2f7 100%);
        -fx-background-radius: 10px;
        -fx-padding: 8px 15px;
        -fx-border-color: #e2e8f0;
        -fx-border-width: 1px;
        -fx-border-radius: 10px;
        }

        .stat-text {
        -fx-text-fill: #4a5568;
        -fx-font-weight: bold;
        -fx-font-size: 13px;
        }

    </style>

    <!-- Conteneur principal -->
    <VBox spacing="15" alignment="TOP_CENTER" styleClass="main-container">

        <!-- En-tête avec icône et croix de fermeture -->
        <HBox alignment="CENTER" styleClass="header">
            <HBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40">
                    <Image url="https://img.icons8.com/fluency/48/school.png"/>
                </ImageView>
                <Label text="Gestion des Programmes" styleClass="titre-principal"/>
            </HBox>

            <!-- Croix de fermeture -->
            <Button styleClass="close-button" onAction="#fermerFenetre">
                <graphic>
                    <ImageView fitHeight="18" fitWidth="18">
                        <Image url="https://img.icons8.com/color/48/delete-sign--v1.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Grille des champs -->
        <GridPane hgap="20" vgap="12" alignment="CENTER" styleClass="form-grid">
            <!-- Nom -->
            <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="0" alignment="CENTER_LEFT" styleClass="field-container">
                <ImageView fitHeight="20" fitWidth="20">
                    <Image url="https://img.icons8.com/color/48/program.png"/>
                </ImageView>
                <TextField fx:id="tfNom" promptText="Nom du programme" styleClass="custom-field"/>
            </HBox>

            <!-- Niveau -->
            <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1" alignment="CENTER_LEFT" styleClass="field-container">
                <ImageView fitHeight="20" fitWidth="20">
                    <Image url="https://img.icons8.com/color/48/level.png"/>
                </ImageView>
                <TextField fx:id="tfNiveau" promptText="Niveau" styleClass="custom-field"/>
            </HBox>

            <!-- Durée -->
            <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2" alignment="CENTER_LEFT" styleClass="field-container">
                <ImageView fitHeight="20" fitWidth="20">
                    <Image url="https://img.icons8.com/color/48/clock.png"/>
                </ImageView>
                <TextField fx:id="tfDuree" promptText="Durée (en mois)" styleClass="custom-field"/>
            </HBox>

            <!-- Description -->
            <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2" alignment="CENTER_LEFT" styleClass="field-container">
                <ImageView fitHeight="20" fitWidth="20">
                    <Image url="https://img.icons8.com/color/48/description.png"/>
                </ImageView>
                <TextArea fx:id="tfDescription" promptText="Description du programme" prefRowCount="3" styleClass="custom-area"/>
            </HBox>
        </GridPane>

        <!-- Boutons d'action FINS -->
        <HBox styleClass="boutons-container">
            <Button text="Ajouter" styleClass="button-action button-ajouter" onAction="#ajouterProgramme">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="https://img.icons8.com/color/48/plus-math.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Modifier" styleClass="button-action button-modifier" onAction="#modifierProgramme">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="https://img.icons8.com/color/48/edit.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Supprimer" styleClass="button-action button-supprimer" onAction="#supprimerProgramme">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="https://img.icons8.com/color/48/delete-forever.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Panneau d'information -->
        <HBox styleClass="info-panel" spacing="10" alignment="CENTER">
            <ImageView fitHeight="16" fitWidth="16">
                <Image url="https://img.icons8.com/color/48/info.png"/>
            </ImageView>
            <Label text="Sélectionnez un programme dans le tableau pour le modifier ou le supprimer" styleClass="info-text"/>
            <Label text="Nouveau" styleClass="badge"/>
        </HBox>

        <!-- TableView -->
        <TableView fx:id="tableProgramme" prefHeight="280" styleClass="custom-table">
            <columns>
                <TableColumn fx:id="colNom" text="Nom du Programme" prefWidth="220"/>
                <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="120"/>
                <TableColumn fx:id="colDuree" text="Durée" prefWidth="120"/>
            </columns>
        </TableView>

        <!-- Pied de page avec statistiques -->
        <HBox styleClass="footer" alignment="CENTER" spacing="20">
            <HBox spacing="8" alignment="CENTER">
                <ImageView fitHeight="16" fitWidth="16">
                    <Image url="https://img.icons8.com/color/48/statistics.png"/>
                </ImageView>
                <Label fx:id="lblTotalProgrammes" text="Total programmes: 0" styleClass="stat-text"/>
            </HBox>
        </HBox>
    </VBox>
</VBox>