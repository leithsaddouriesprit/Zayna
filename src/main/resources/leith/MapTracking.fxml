<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<?import java.lang.String?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.leith.MapTrackingController"
            styleClass="root">

    <stylesheets>
        <String fx:value="/leith/tracking.css"/>
    </stylesheets>

    <WebView fx:id="mapView"
             AnchorPane.topAnchor="0.0"
             AnchorPane.bottomAnchor="0.0"
             AnchorPane.leftAnchor="0.0"
             AnchorPane.rightAnchor="0.0"/>

    <VBox maxWidth="420" spacing="10"
          styleClass="overlay-card"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.bottomAnchor="20.0">

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-row">
            <Label text="🚌" styleClass="bus-emoji"/>

            <VBox spacing="2">
                <Label fx:id="lblTitle" text="Suivi du bus de votre enfant" styleClass="title"/>
                <Label fx:id="lblSubTitle" text="Informations en temps réel" styleClass="subtitle"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <VBox alignment="TOP_RIGHT" spacing="4" styleClass="right-block">
                <Label fx:id="lblEnfantNom" text="—" styleClass="child-name"/>
                <Label fx:id="lblEnfantStatus" text="—" styleClass="status-badge"/>
            </VBox>
        </HBox>

        <Separator styleClass="sep"/>

        <GridPane hgap="14" vgap="10" styleClass="info-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="45"/>
                <ColumnConstraints percentWidth="55"/>
            </columnConstraints>

            <Label text="Chauffeur :" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="key"/>
            <Label fx:id="lblChauffeur" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="value"/>

            <Label text="Bus :" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="key"/>
            <Label fx:id="lblBus" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="value"/>

            <Label fx:id="lblEtaTitle" text="Arrivée estimée :" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="key"/>
            <Label fx:id="lblEtaValue" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="eta"/>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="actions">
            <Button onAction="#recenter" text="Recentrer" styleClass="btn-primary"/>
            <Button onAction="#close" text="Fermer" styleClass="btn-secondary"/>
        </HBox>

    </VBox>

</AnchorPane>
