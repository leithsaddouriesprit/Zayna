<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.GestionReclamationController"
            style="-fx-background-color: #000000;"
            stylesheets="@/leith/design/global.css">

    <children>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <VBox spacing="20" style="-fx-padding: 25;">

                <!-- ========== EN-TÊTE ========== -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane>
                        <Circle radius="35" fill="linear-gradient(to bottom right, #FEC111, #E7B541)"/>
                        <Label text="📋" style="-fx-font-size: 32px; -fx-text-fill: #1A1A1A; -fx-font-weight: bold;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Gestion des Réclamations" styleClass="admin-page-title" style="-fx-font-size: 28px;"/>
                        <Label text="Soumettre et suivre vos réclamations" styleClass="text-muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Barre de recherche -->
                    <HBox spacing="8" styleClass="surface-panel-soft" style="-fx-background-radius: 30; -fx-padding: 4;">
                        <TextField fx:id="searchField"
                                   promptText="Rechercher..."
                                   styleClass="text-field"
                                   style="-fx-background-radius: 30; -fx-border-radius: 30; -fx-padding: 10 18;"
                                   prefWidth="260"/>
                        <Button text="🔍 Rechercher"
                                onAction="#rechercherReclamation"
                                styleClass="btn-primary"
                                style="-fx-background-radius: 30; -fx-padding: 8 20;"/>
                    </HBox>
                </HBox>

                <!-- ========== STATISTIQUES (CARTES) ========== -->
                <HBox spacing="20" alignment="CENTER">
                    <!-- Carte Total -->
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="📊" style="-fx-font-size: 32px;"/>
                        <Label text="Total" styleClass="stat-card-title"/>
                        <Label fx:id="totalReclamations" text="0" styleClass="stat-card-value" style="-fx-text-fill: #FEC111;"/>
                    </VBox>

                    <!-- Carte En attente -->
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="⏳" style="-fx-font-size: 32px;"/>
                        <Label text="En attente" styleClass="stat-card-title"/>
                        <Label fx:id="enAttenteCount" text="0" styleClass="stat-card-value" style="-fx-text-fill: #FEC111;"/>
                    </VBox>

                    <!-- Carte Traitées -->
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="✅" style="-fx-font-size: 32px;"/>
                        <Label text="Traitées" styleClass="stat-card-title"/>
                        <Label fx:id="traiteesCount" text="0" styleClass="stat-card-value" style="-fx-text-fill: #FEC111;"/>
                    </VBox>
                </HBox>

                <!-- ========== FORMULAIRE DE RÉCLAMATION ========== -->
                <VBox spacing="18" styleClass="surface-panel" style="-fx-padding: 25; -fx-background-radius: 20;">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane>
                            <Circle radius="20" fill="linear-gradient(to bottom right, #FEC111, #E7B541)"/>
                            <Label text="✏️" style="-fx-font-size: 18px; -fx-text-fill: #1A1A1A;"/>
                        </StackPane>
                        <Label text="Nouvelle réclamation" styleClass="title-lg"/>
                    </HBox>

                    <GridPane hgap="15" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" prefWidth="100"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Type" styleClass="section-title" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ChoiceBox fx:id="typeChoice" prefWidth="280" styleClass="combo-box" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Message" styleClass="section-title" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextArea fx:id="messageField" prefRowCount="4" wrapText="true" promptText="Décrivez votre réclamation..." styleClass="text-area" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <!-- Détails dynamiques -->
                        <Label text="Détails" styleClass="section-title" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <StackPane GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="130" styleClass="surface-panel-soft" style="-fx-padding: 12;">

                            <VBox fx:id="panelChauffeur" spacing="10" managed="false" visible="false">
                                <TextField fx:id="chauffeurNomField" promptText="Nom du chauffeur" styleClass="text-field"/>
                                <TextField fx:id="chauffeurPrenomField" promptText="Prénom du chauffeur" styleClass="text-field"/>
                            </VBox>

                            <VBox fx:id="panelBus" spacing="10" managed="false" visible="false">
                                <TextField fx:id="busMatriculeField" promptText="Matricule du bus" styleClass="text-field"/>
                            </VBox>

                            <VBox fx:id="panelCantine" spacing="10" managed="false" visible="false">
                                <ChoiceBox fx:id="cantineTypeChoice" prefWidth="280" styleClass="combo-box"/>
                            </VBox>

                            <VBox fx:id="panelEcole" spacing="10" managed="false" visible="false">
                                <TextField fx:id="ecoleNomField" promptText="Nom de l'école" styleClass="text-field"/>
                            </VBox>

                            <VBox fx:id="panelAutre" spacing="10" managed="false" visible="false">
                                <TextField fx:id="autrePrecisionField" promptText="Précision" styleClass="text-field"/>
                            </VBox>

                            <VBox fx:id="panelTrajet" spacing="10" managed="false" visible="false" alignment="CENTER">
                                <Label text="✓ Aucun détail requis" style="-fx-text-fill: #FEC111; -fx-font-weight: bold;"/>
                            </VBox>
                        </StackPane>

                        <!-- Traduction -->
                        <Label text="Traduction" styleClass="section-title" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <VBox GridPane.rowIndex="3" GridPane.columnIndex="1" spacing="8">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <ChoiceBox fx:id="langueCibleChoice" prefWidth="160" styleClass="combo-box"/>
                                <Label text="Langue cible" style="-fx-text-fill: #FEC111; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            </HBox>
                            <Label fx:id="traductionLabel" text="Cliquez sur Traduire" wrapText="true" styleClass="text-muted" style="-fx-font-style: italic;"/>
                        </VBox>
                    </GridPane>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button text="🌐 Traduire" onAction="#traduireMessage" styleClass="btn-primary"/>
                        <Button text="🗑️ Vider" onAction="#viderFormulaire" styleClass="btn-secondary"/>
                        <Button fx:id="envoyerButton" text="📤 Envoyer" onAction="#envoyerReclamation" styleClass="btn-primary" style="-fx-background-color: linear-gradient(to right, #22c55e, #16a34a);"/>
                        <Button text="✏️ Modifier" onAction="#modifierReclamation" styleClass="btn-secondary"/>
                        <Button text="❌ Supprimer" onAction="#supprimerReclamation" styleClass="btn-danger"/>
                    </HBox>
                </VBox>

                <!-- Message de statut -->
                <Label fx:id="statusLabel" text="" wrapText="true" styleClass="info-box" style="-fx-padding: 10 18; -fx-background-radius: 20;"/>

                <!-- ========== TABLEAU DES RÉCLAMATIONS ========== -->
                <VBox spacing="12"
                      styleClass="surface-panel"
                      style="-fx-padding: 20;"
                      VBox.vgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane>
                            <Circle radius="14" fill="#FEC111"/>
                            <Label text="📋" style="-fx-font-size: 12px; -fx-text-fill: #1A1A1A;"/>
                        </StackPane>
                        <Label text="Mes réclamations" styleClass="title-md"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="compteurReclamations" text="0 réclamation(s)"
                               style="-fx-background-color: #FEC111; -fx-text-fill: #1A1A1A; -fx-background-radius: 20; -fx-padding: 5 15; -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="tableReclamation"
                               VBox.vgrow="ALWAYS"
                               prefHeight="400"
                               minHeight="300"
                               styleClass="reclamation-table">
                        <columns>
                            <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                            <TableColumn fx:id="colDescription" text="Message" prefWidth="350"/>
                            <TableColumn fx:id="colDetails" text="Détails" prefWidth="180"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
                <!-- ========== SECTION RÉPONSE ADMIN ========== -->
                <VBox spacing="12" styleClass="surface-panel" style="-fx-padding: 20; -fx-border-color: #FEC111; -fx-border-width: 0 0 0 3; -fx-border-radius: 12;">

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane>
                            <Circle radius="18" fill="linear-gradient(to bottom right, #FEC111, #E7B541)"/>
                            <Label text="👤" style="-fx-font-size: 14px; -fx-text-fill: #1A1A1A;"/>
                        </StackPane>
                        <VBox>
                            <Label text="Réponse administration" styleClass="title-md"/>
                            <Label text="L'équipe vous répondra rapidement" styleClass="text-muted"/>
                        </VBox>
                    </HBox>

                    <TextArea fx:id="reponseArea" editable="false" prefRowCount="4" wrapText="true" promptText="Aucune réponse..." styleClass="text-area"/>

                    <Label fx:id="reponseAuteurLabel" text="" style="-fx-text-fill: #FEC111; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Circle radius="5" fill="#FEC111"/>
                        <Label text="Statut :" styleClass="text-muted"/>
                        <Label fx:id="statutReponseLabel" text="En attente" style="-fx-text-fill: #FEC111; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="traduireReponseButton" text="🌐 Traduire" onAction="#traduireReponse" disable="true" styleClass="btn-secondary"/>
                    </HBox>

                    <Label fx:id="traductionReponseLabel" text="" wrapText="true" styleClass="text-muted" style="-fx-font-style: italic;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </children>
</AnchorPane>