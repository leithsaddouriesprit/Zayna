<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.workshop.controlleurs.GestionReponseController">

    <top>
        <VBox spacing="10" padding="15">
            <Label text="Gestion des Réponses (Admin)"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableReclamation">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                <TableColumn fx:id="colDescription" text="Message" prefWidth="250"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10" padding="15">

            <Label text="Réponse :" />
            <TextArea fx:id="reponseField" prefRowCount="3"/>

            <Button text="Répondre"
                    onAction="#repondreReclamation"/>

            <Label fx:id="statusLabel" textFill="green"/>

        </VBox>
    </bottom>

</BorderPane>
