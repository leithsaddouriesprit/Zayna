<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>  <!-- AJOUTER CET IMPORT -->


<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.GestionReclamationController"
            style="-fx-background-color: #f5f7fa;">

    <children>
        <VBox spacing="15"
              AnchorPane.topAnchor="20"
              AnchorPane.leftAnchor="20"
              AnchorPane.rightAnchor="20"
              AnchorPane.bottomAnchor="20">

            <!-- En-tête avec titre et icône -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋" style="-fx-font-size: 32px;"/>
                <VBox>
                    <Label text="Gestion des Réclamations"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Soumettre et suivre vos réclamations"
                           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>

            <Separator/>

            <!-- Formulaire de réclamation (panel blanc avec ombre) -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <Label text="✏️ Nouvelle réclamation"
                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;"/>

                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Type -->
                    <Label text="Type :"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ChoiceBox fx:id="typeChoice"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"
                               prefWidth="300"
                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 5 10;"/>

                    <!-- Message -->
                    <Label text="Message :"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextArea fx:id="messageField"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"
                              prefRowCount="4"
                              wrapText="true"
                              promptText="Décrivez votre réclamation en détails..."
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 10;"/>

                    <!-- Détails spécifiques selon le type -->
                    <Label text="Détails :"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>

                    <StackPane GridPane.rowIndex="2"
                               GridPane.columnIndex="1"
                               prefHeight="120">

                        <!-- Panel Chauffeur -->
                        <VBox fx:id="panelChauffeur" spacing="8" managed="false" visible="false">
                            <Label text="Nom du chauffeur :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="chauffeurNomField" promptText="Ex: DUPONT"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 8;"/>
                            <Label text="Prénom du chauffeur :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="chauffeurPrenomField" promptText="Ex: Jean"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 8;"/>
                        </VBox>

                        <!-- Panel Bus -->
                        <VBox fx:id="panelBus" spacing="8" managed="false" visible="false">
                            <Label text="Matricule du bus :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="busMatriculeField" promptText="Ex: 1234 TN 15"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 8;"/>
                        </VBox>

                        <!-- Panel Cantine (CORRIGÉ) -->
                        <VBox fx:id="panelCantine" spacing="8" managed="false" visible="false">
                            <Label text="Type de problème :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            <ChoiceBox fx:id="cantineTypeChoice" prefWidth="300"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 5 10;">
                                <String fx:value="Qualité des repas"/>
                                <String fx:value="Quantité insuffisante"/>
                                <String fx:value="Hygiène"/>
                                <String fx:value="Service"/>
                                <String fx:value="Autre"/>
                            </ChoiceBox>
                        </VBox>

                        <!-- Panel École -->
                        <VBox fx:id="panelEcole" spacing="8" managed="false" visible="false">
                            <Label text="Nom de l'école :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="ecoleNomField" promptText="Ex: École Primaire Centre"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 8;"/>
                        </VBox>

                        <!-- Panel Autre -->
                        <VBox fx:id="panelAutre" spacing="8" managed="false" visible="false">
                            <Label text="Précision :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="autrePrecisionField" promptText="Ex: Problème administratif"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 8;"/>
                        </VBox>

                        <!-- Panel Trajet (aucun détail) -->
                        <VBox fx:id="panelTrajet" spacing="8" managed="false" visible="false" alignment="CENTER">
                            <Label text="✓ Aucun détail supplémentaire requis"
                                   style="-fx-font-size: 12px; -fx-text-fill: #27ae60; -fx-font-style: italic; -fx-padding: 20 0;"/>
                        </VBox>
                    </StackPane>
                </GridPane>

                <!-- Barre d'outils avec boutons -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <!-- Bouton Vider -->
                    <Button text="🗑️ Vider"
                            onAction="#viderFormulaire"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand; -fx-font-weight: bold;"/>

                    <!-- Bouton Envoyer -->
                    <Button text="📤 Envoyer"
                            onAction="#envoyerReclamation"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>

                    <!-- Bouton Modifier -->
                    <Button text="✏️ Modifier"
                            onAction="#modifierReclamation"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>

                    <!-- Bouton Supprimer -->
                    <Button text="❌ Supprimer"
                            onAction="#supprimerReclamation"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Barre de recherche -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Rechercher une réclamation..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 15; -fx-border-color: #e0e0e0; -fx-background-color: white;"/>
                <Button text="🔍 Rechercher"
                        onAction="#rechercherReclamation"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <!-- Message de statut -->
            <Label fx:id="statusLabel"
                   text=""
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-padding: 10; -fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-text-fill: #2c3e50;"/>

            <!-- Liste des réclamations -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                  VBox.vgrow="ALWAYS">

                <Label text="📋 Mes réclamations"
                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;"/>

                <TableView fx:id="tableReclamation"
                           VBox.vgrow="ALWAYS"
                           prefHeight="250"
                           style="-fx-background-radius: 10;">
                    <columns>
                        <!-- La colonne ID reste mais n'affichera rien (modifié dans le controller) -->
                        <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="colDescription" text="Message" prefWidth="300"/>
                        <TableColumn fx:id="colDetails" text="Détails" prefWidth="150"/>  <!-- NOUVELLE COLONNE -->
                        <TableColumn fx:id="colDate" text="Date" prefWidth="130"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- SECTION REPONSE ADMIN -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: #3498db; -fx-border-width: 0 0 0 5; -fx-border-radius: 15;">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 20px;"/>
                    <VBox>
                        <Label text="Réponse de l'administration"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                        <Label text="L'administrateur répondra à votre réclamation dans les plus brefs délais"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>

                <TextArea fx:id="reponseArea"
                          editable="false"
                          prefRowCount="4"
                          wrapText="true"
                          promptText="Aucune réponse pour le moment..."
                          style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 13px;"/>

                <!-- Indicateur de statut de réponse -->
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="●"
                           style="-fx-text-fill: #f39c12; -fx-font-size: 12px;"/>
                    <Label text="Statut :"
                           style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                    <Label fx:id="statutReponseLabel"
                           text="En attente de réponse"
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                </HBox>
            </VBox>

        </VBox>
    </children>
</AnchorPane>