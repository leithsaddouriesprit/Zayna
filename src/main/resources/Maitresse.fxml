<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.workshop.controlleurs.MaitresseController"
      spacing="20" alignment="TOP_CENTER"
      style="
          -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #a8edea 0%, #fed6e3 50%, #89f7fe 100%);
          -fx-background-radius: 30px;
          -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.25), 30, 0, 0, 15);
          -fx-padding: 25px;
          -fx-max-width: 1200px;
          -fx-font-family: 'Segoe UI', 'Poppins', 'Arial', sans-serif;
      ">

    <style>
        /* ===== STYLE GLOBAL ===== */
        * {
        -fx-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ===== CONTENEUR PRINCIPAL ===== */
        .main-container {
        -fx-background-color: rgba(255, 255, 255, 0.97);
        -fx-background-radius: 25px;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.15), 20, 0, 0, 5);
        -fx-padding: 30px;
        }

        /* ===== EN-TÊTE ===== */
        .header {
        -fx-padding: 0 0 20px 0;
        -fx-border-width: 0 0 3px 0;
        -fx-border-color: linear-gradient(from 0% 0% to 100% 100%, #5dade2 0%, #48c9b0 100%);
        -fx-border-insets: 0 0 20px 0;
        }

        .titre-principal {
        -fx-font-size: 28px;
        -fx-font-weight: bold;
        -fx-text-fill: #1a2639;
        -fx-effect: dropshadow(gaussian, rgba(93, 173, 226, 0.3), 10, 0, 0, 2);
        }

        /* ===== CARTE DE FORMULAIRE ===== */
        .form-card {
        -fx-background-color: #f8fafd;
        -fx-background-radius: 20px;
        -fx-padding: 20px;
        -fx-border-color: rgba(93, 173, 226, 0.2);
        -fx-border-width: 2px;
        -fx-border-radius: 20px;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.05), 10, 0, 0, 2);
        }

        .form-title {
        -fx-font-size: 18px;
        -fx-font-weight: bold;
        -fx-text-fill: #2c3e50;
        -fx-padding: 0 0 15px 0;
        -fx-border-width: 0 0 2px 0;
        -fx-border-color: linear-gradient(from 0% 0% to 100% 100%, #5dade2 0%, #48c9b0 100%);
        }

        .form-grid {
        -fx-hgap: 20px;
        -fx-vgap: 15px;
        -fx-padding: 10px 0;
        }

        .field-label {
        -fx-font-size: 14px;
        -fx-font-weight: 600;
        -fx-text-fill: #2c3e50;
        -fx-alignment: CENTER_RIGHT;
        -fx-padding: 0 15px 0 0;
        -fx-min-width: 120px;
        }

        /* ===== CHAMPS DE SAISIE ===== */
        .custom-field, .custom-area {
        -fx-background-color: white;
        -fx-border-color: #e0e7ed;
        -fx-border-width: 2px;
        -fx-border-radius: 12px;
        -fx-background-radius: 12px;
        -fx-padding: 12px 15px;
        -fx-font-size: 14px;
        -fx-prompt-text-fill: #94a3b8;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.02), 5, 0, 0, 2);
        -fx-min-width: 280px;
        }

        .custom-field:focused, .custom-area:focused {
        -fx-border-color: #5dade2;
        -fx-border-width: 2.5px;
        -fx-effect: dropshadow(gaussian, rgba(93, 173, 226, 0.25), 15, 0, 0, 4);
        }

        .custom-area {
        -fx-min-height: 80px;
        -fx-min-width: 600px;
        -fx-wrap-text: true;
        }

        /* ===== COMBOBOX ===== */
        .custom-combo {
        -fx-background-color: white;
        -fx-border-color: #e0e7ed;
        -fx-border-width: 2px;
        -fx-border-radius: 12px;
        -fx-background-radius: 12px;
        -fx-padding: 8px 12px;
        -fx-font-size: 14px;
        -fx-min-width: 280px;
        }

        .custom-combo:hover, .custom-combo:focused {
        -fx-border-color: #5dade2;
        }

        /* ===== BOUTONS ===== */
        .button-action {
        -fx-background-radius: 25px;
        -fx-padding: 12px 25px;
        -fx-font-size: 14px;
        -fx-font-weight: bold;
        -fx-cursor: hand;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.1), 8, 0, 0, 3);
        -fx-min-width: 120px;
        -fx-alignment: center;
        -fx-spacing: 8px;
        }

        .button-action:hover {
        -fx-scale-x: 1.05;
        -fx-scale-y: 1.05;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.15), 12, 0, 0, 5);
        }

        .button-ajouter {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #2ecc71 0%, #27ae60 100%);
        -fx-text-fill: white;
        }

        .button-modifier {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f39c12 0%, #e67e22 100%);
        -fx-text-fill: white;
        }

        .button-supprimer {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #e74c3c 0%, #c0392b 100%);
        -fx-text-fill: white;
        }

        .button-presence {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #5dade2 0%, #48c9b0 100%);
        -fx-text-fill: white;
        }

        .button-vider {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #95a5a6 0%, #7f8c8d 100%);
        -fx-text-fill: white;
        }

        /* ===== BADGES DE STATUT ===== */
        .badge-present {
        -fx-background-color: #27ae60;
        -fx-background-radius: 20px;
        -fx-padding: 4px 12px;
        -fx-text-fill: white;
        -fx-font-weight: bold;
        -fx-font-size: 12px;
        }

        .badge-absent {
        -fx-background-color: #e74c3c;
        -fx-background-radius: 20px;
        -fx-padding: 4px 12px;
        -fx-text-fill: white;
        -fx-font-weight: bold;
        -fx-font-size: 12px;
        }

        .badge-retard {
        -fx-background-color: #f39c12;
        -fx-background-radius: 20px;
        -fx-padding: 4px 12px;
        -fx-text-fill: white;
        -fx-font-weight: bold;
        -fx-font-size: 12px;
        }

        /* ===== TABLEAU ===== */
        .custom-table {
        -fx-background-color: transparent;
        -fx-border-color: rgba(226, 232, 240, 0.5);
        -fx-border-width: 1px;
        -fx-border-radius: 15px;
        -fx-background-radius: 15px;
        -fx-padding: 5px;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.08), 15, 0, 0, 3);
        }

        .custom-table .column-header-background {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #5dade2 0%, #48c9b0 100%);
        -fx-background-radius: 12px 12px 0 0;
        -fx-padding: 10px 0;
        }

        .custom-table .column-header .label {
        -fx-font-size: 14px;
        -fx-font-weight: bold;
        -fx-text-fill: white;
        -fx-alignment: center;
        }

        .custom-table .table-row-cell {
        -fx-background-color: white;
        -fx-border-color: transparent transparent #edf2f7 transparent;
        }

        .custom-table .table-row-cell:odd {
        -fx-background-color: #fafcff;
        }

        .custom-table .table-row-cell:hover {
        -fx-background-color: #d6eaf8;
        }

        .custom-table .table-cell {
        -fx-padding: 10px 8px;
        -fx-font-size: 13px;
        -fx-text-fill: #2c3e50;
        -fx-alignment: center;
        }

        /* ===== STATISTIQUES ===== */
        .stats-card {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #5dade2 0%, #48c9b0 100%);
        -fx-background-radius: 15px;
        -fx-padding: 15px;
        -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.1), 8, 0, 0, 3);
        }

        .stats-number {
        -fx-font-size: 28px;
        -fx-font-weight: bold;
        -fx-text-fill: white;
        }

        .stats-label {
        -fx-font-size: 12px;
        -fx-text-fill: rgba(255, 255, 255, 0.8);
        }

        /* ===== MESSAGE INFO ===== */
        .info-message {
        -fx-background-color: #d6eaf8;
        -fx-background-radius: 12px;
        -fx-padding: 15px;
        -fx-border-color: #5dade2;
        -fx-border-width: 1px;
        -fx-border-radius: 12px;
        }

        /* ===== SCROLLBAR ===== */
        .scroll-bar:vertical {
        -fx-background-color: transparent;
        -fx-background-radius: 10px;
        -fx-padding: 5px;
        }

        .scroll-bar:vertical .thumb {
        -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #cbd5e0 0%, #a0aec0 100%);
        -fx-background-radius: 10px;
        }
    </style>

    <!-- Conteneur principal -->
    <VBox spacing="15" alignment="TOP_CENTER" styleClass="main-container">

        <!-- En-tête -->
        <HBox alignment="CENTER" styleClass="header">
            <HBox spacing="15" alignment="CENTER">
                <ImageView fitHeight="50" fitWidth="50">
                    <Image url="https://img.icons8.com/fluency/48/teacher.png"/>
                </ImageView>
                <Label text="👩‍🏫 Espace Maîtresse - Gestion des enfants" styleClass="titre-principal"/>
            </HBox>
        </HBox>

        <!-- Statistiques en haut -->
        <HBox spacing="20" alignment="CENTER">
            <VBox spacing="5" alignment="CENTER" styleClass="stats-card">
                <Label fx:id="lblTotalEnfants" text="0" styleClass="stats-number"/>
                <Label text="Total enfants" styleClass="stats-label"/>
            </VBox>
            <VBox spacing="5" alignment="CENTER" styleClass="stats-card">
                <Label fx:id="lblPresentAujourdhui" text="0" styleClass="stats-number"/>
                <Label text="Présents aujourd'hui" styleClass="stats-label"/>
            </VBox>
            <VBox spacing="5" alignment="CENTER" styleClass="stats-card">
                <Label fx:id="lblAbsentAujourdhui" text="0" styleClass="stats-number"/>
                <Label text="Absents aujourd'hui" styleClass="stats-label"/>
            </VBox>
            <VBox spacing="5" alignment="CENTER" styleClass="stats-card">
                <Label fx:id="lblRetardAujourdhui" text="0" styleClass="stats-number"/>
                <Label text="Retards aujourd'hui" styleClass="stats-label"/>
            </VBox>
        </HBox>

        <!-- Grille principale -->
        <GridPane hgap="25" vgap="20">
            <!-- Colonne gauche : Liste des enfants -->
            <VBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="350" styleClass="form-card">
                <Label text="👧 Liste des enfants" styleClass="form-title"/>
                <TableView fx:id="tableEnfants" prefHeight="400" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colEnfantNom" text="Nom" prefWidth="120"/>
                        <TableColumn fx:id="colEnfantClasse" text="Classe" prefWidth="80"/>
                        <TableColumn fx:id="colEnfantStatut" text="Statut" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Colonne droite : Formulaire et présence -->
            <VBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="650">

                <!-- Carte gestion des enfants -->
                <VBox styleClass="form-card">
                    <Label text="👧 Gestion des enfants" styleClass="form-title"/>

                    <GridPane styleClass="form-grid">
                        <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="tfNom" promptText="Nom de l'enfant" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Prénom:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="tfPrenom" promptText="Prénom de l'enfant" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Date naissance:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                        <DatePicker fx:id="dpDateNaissance" promptText="JJ/MM/AAAA" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Classe:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="tfClasse" promptText="Ex: CP1, CE2, CM1..." GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Téléphone parent:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="tfTelephone" promptText="Numéro du parent" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Email parent:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="tfEmail" promptText="Email du parent" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="custom-field"/>
                    </GridPane>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="Ajouter" styleClass="button-action button-ajouter" onAction="#ajouterEnfant"/>
                        <Button text="Modifier" styleClass="button-action button-modifier" onAction="#modifierEnfant"/>
                        <Button text="Supprimer" styleClass="button-action button-supprimer" onAction="#supprimerEnfant"/>
                        <Button text="Vider" styleClass="button-action button-vider" onAction="#clearEnfantFields"/>
                    </HBox>
                </VBox>

                <!-- Carte présence quotidienne -->
                <VBox styleClass="form-card">
                    <Label text="📝 Gestion de présence" styleClass="form-title"/>

                    <GridPane styleClass="form-grid">
                        <Label text="Date:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                        <DatePicker fx:id="dpDatePresence" promptText="JJ/MM/AAAA" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Statut matin:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                        <ComboBox fx:id="cbStatutMatin" promptText="Sélectionnez un statut" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="custom-combo"/>

                        <Label text="Heure arrivée:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="tfHeureArrivee" promptText="HH:MM" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Heure départ:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="tfHeureDepart" promptText="HH:MM" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="custom-field"/>

                        <Label text="Statut midi:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
                        <ComboBox fx:id="cbStatutMidi" promptText="Sélectionnez un statut" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="custom-combo"/>

                        <Label text="Statut soir:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
                        <ComboBox fx:id="cbStatutSoir" promptText="Sélectionnez un statut" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="custom-combo"/>

                        <Label text="Remorque:" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <CheckBox fx:id="chkRemorque" text="Pris par remorque"/>
                            <TextField fx:id="tfRemorqueur" promptText="Nom du remorqueur" styleClass="custom-field"/>
                        </HBox>

                        <Label text="Observations:" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="field-label"
                               style="-fx-alignment: TOP_RIGHT; -fx-padding: 10 15 0 0;"/>
                        <TextArea fx:id="tfObservations" promptText="Observations..." prefHeight="60" GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="custom-area"/>
                    </GridPane>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="📝 Enregistrer présence" styleClass="button-action button-presence" onAction="#enregistrerPresence"/>
                        <Button text="Voir historique" styleClass="button-action button-modifier" onAction="#voirHistorique"/>
                    </HBox>
                </VBox>

                <!-- Message d'information -->
                <HBox styleClass="info-message" spacing="10" alignment="CENTER">
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="https://img.icons8.com/color/48/info.png"/>
                    </ImageView>
                    <Label text="Sélectionnez un enfant dans la liste pour gérer sa présence"/>
                </HBox>
            </VBox>
        </GridPane>

        <!-- Pied de page -->
        <HBox alignment="CENTER" style="-fx-padding: 20px 0 0 0; -fx-border-width: 1px 0 0 0; -fx-border-color: #e0e7ed;">
            <Label text="© 2024 - Espace Maîtresse - Tous droits réservés" style="-fx-text-fill: #7f8c8d;"/>
        </HBox>
    </VBox>
</VBox>