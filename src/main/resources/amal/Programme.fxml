<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.amal.ProgrammeController"
      styleClass="content-area admin-main-panel parent-page amal-page" spacing="14">
    <stylesheets>
        <URL value="@../leith/design/global.css"/>
        <URL value="@amal-integration.css"/>
    </stylesheets>
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Gestion des programmes" styleClass="admin-page-title" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Label fx:id="lblEcoleConnectee" text="" styleClass="admin-page-subtitle"/>

    <VBox spacing="12" styleClass="admin-section-panel parent-section-panel">
        <GridPane hgap="10" vgap="10">
            <Label text="Nom:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="tfNom" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="260"/>
            <Label text="Niveau:" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="tfNiveau" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="180"/>
            <Label text="Duree (mois):" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="tfDuree" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="120"/>
            <Label text="Description:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextArea fx:id="tfDescription" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3" prefRowCount="3"/>
        </GridPane>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button text="Ajouter" styleClass="btn-primary" onAction="#ajouterProgramme"/>
            <Button text="Modifier" styleClass="btn-secondary" onAction="#modifierProgramme"/>
            <Button text="Supprimer" styleClass="btn-soft" onAction="#supprimerProgramme"/>
        </HBox>
    </VBox>

    <TableView fx:id="tableProgramme" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNom" text="Nom du programme" prefWidth="280"/>
            <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="180"/>
            <TableColumn fx:id="colDuree" text="Duree (mois)" prefWidth="160"/>
        </columns>
    </TableView>

    <HBox styleClass="summary-box" alignment="CENTER_LEFT">
        <Label fx:id="lblTotalProgrammes" text="" styleClass="summary-text"/>
    </HBox>
</VBox>