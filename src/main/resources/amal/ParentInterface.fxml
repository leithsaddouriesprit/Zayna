<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.workshop.controlleurs.amal.ParentController"
      styleClass="content-area admin-main-panel parent-page amal-page" spacing="14">
    <stylesheets>
        <URL value="@../leith/design/global.css"/>
        <URL value="@amal-integration.css"/>
    </stylesheets>
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="6">
        <Label text="Demande de transport — choix de l'établissement" styleClass="admin-page-title"/>
        <Label text="Sélectionnez un établissement pour voir ses programmes et accéder aux trajets." styleClass="admin-page-subtitle"/>
    </VBox>

    <GridPane hgap="16" vgap="14" VBox.vgrow="ALWAYS">
        <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="300" styleClass="admin-section-panel parent-section-panel">
            <Label text="Établissements" styleClass="section-title"/>
            <ListView fx:id="listViewEcoles" VBox.vgrow="ALWAYS" styleClass="parent-list-view"/>
        </VBox>

        <VBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="admin-section-panel parent-section-panel" GridPane.hgrow="ALWAYS">
            <VBox fx:id="detailsContainer" visible="false" managed="false" spacing="8">
                <Label text="À propos de l'établissement" styleClass="section-title"/>
                <Label fx:id="lblNomEcole" text="-"/>
                <Label fx:id="lblPositionEcole" text="-"/>
                <Label fx:id="lblPrixEcole" text="-"/>
                <Label fx:id="lblDescriptionEcole" text="-" wrapText="true"/>
                <Label fx:id="lblInfosEcole" text="-" wrapText="true"/>
                <HBox spacing="10">
                    <Button fx:id="btnInscrire" text="S'inscrire" styleClass="btn-primary" onAction="#inscrireEnfant"/>
                    <Button text="Trajets" styleClass="btn-secondary" onAction="#voirTrajets"/>
                    <Button text="Calendrier" styleClass="btn-soft" onAction="#voirCalendrier"/>
                    <Button text="Meteo" styleClass="btn-soft" onAction="#voirMeteo"/>
                </HBox>
            </VBox>

            <VBox fx:id="messageContainer" styleClass="alert-box">
                <Label text="Choisissez un établissement pour continuer." styleClass="alert-text"/>
            </VBox>

            <VBox fx:id="programmesContainer" visible="false" managed="false" spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Programmes" styleClass="section-title"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <FlowPane fx:id="programmesFlowPane" hgap="10" vgap="10" prefWrapLength="620"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </GridPane>
</VBox>