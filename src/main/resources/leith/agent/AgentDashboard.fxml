<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.agent.AgentDashboardController"
      styleClass="card" spacing="16" alignment="CENTER_LEFT">
    <stylesheets><URL value="@../app.css"/></stylesheets>
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Tableau de bord Agent – École" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="lblEcole" text="École: --"/>

    <Separator/>

    <Label text="Candidatures chauffeur"/>
    <HBox spacing="8">
        <Button text="Candidatures à traiter (ENVOYEE)" onAction="#openCandidaturesChauffeur"/>
        <Button text="Chauffeurs acceptés" onAction="#openChauffeursAcceptes"/>
    </HBox>

    <Label text="Bus"/>
    <HBox spacing="8">
        <Button text="Gestion Bus" onAction="#openBus"/>
        <Button text="Affecter Chauffeur → Bus" onAction="#openAffecterChauffeurBus"/>
    </HBox>

    <Label text="Trajets"/>
    <HBox spacing="8">
        <Button text="Gestion Trajets" onAction="#openTrajets"/>
        <Button text="Affecter Bus → Trajet" onAction="#openAffecterBusTrajet"/>
    </HBox>

    <Label text="Arrêts"/>
    <HBox spacing="8">
        <Button text="Arrêts d'un trajet" onAction="#openArrets"/>
    </HBox>

    <Label text="Candidatures enfant"/>
    <HBox spacing="8">
        <Button text="Candidatures enfant" onAction="#openCandidaturesEnfant"/>
    </HBox>
</VBox>
