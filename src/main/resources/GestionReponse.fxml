<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<?import java.lang.String?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.GestionReponseController"
            style="-fx-background-color: #000000;"
            stylesheets="@/leith/design/global.css">

    <children>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <VBox spacing="20" style="-fx-padding: 25;">

                <!-- ========== EN-TÊTE ========== -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane>
                        <Circle radius="35" fill="linear-gradient(to bottom right, #FEC111, #E7B541)"/>
                        <Label text="💬" style="-fx-font-size: 32px; -fx-text-fill: #1A1A1A; -fx-font-weight: bold;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Gestion des Réponses" styleClass="admin-page-title" style="-fx-font-size: 28px;"/>
                        <Label text="Administration des réclamations" styleClass="text-muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Barre de recherche -->
                    <HBox spacing="8" styleClass="surface-panel-soft" style="-fx-background-radius: 30; -fx-padding: 4;">
                        <TextField fx:id="searchField"
                                   promptText="Rechercher..."
                                   styleClass="text-field"
                                   style="-fx-background-radius: 30; -fx-border-radius: 30; -fx-padding: 10 18;"
                                   prefWidth="260"/>
                        <Button text="🔍 Rechercher"
                                onAction="#rechercherReponse"
                                styleClass="btn-primary"
                                style="-fx-background-radius: 30; -fx-padding: 8 20;"/>
                        <Button text="⟲"
                                onAction="#reinitialiserRecherche"
                                styleClass="btn-secondary"
                                style="-fx-background-radius: 30; -fx-padding: 8 15;"/>
                    </HBox>
                </HBox>

                <!-- ========== STATISTIQUES (CARTES) ========== -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="📊" style="-fx-font-size: 32px;"/>
                        <Label text="Total réclamations" styleClass="stat-card-title"/>
                        <Label fx:id="totalReclamations" text="0" styleClass="stat-card-value" style="-fx-text-fill: #FEC111;"/>
                    </VBox>

                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="⏳" style="-fx-font-size: 32px;"/>
                        <Label text="En attente" styleClass="stat-card-title"/>
                        <Label fx:id="enAttenteCount" text="0" styleClass="stat-card-value" style="-fx-text-fill: #FEC111;"/>
                    </VBox>

                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="✅" style="-fx-font-size: 32px;"/>
                        <Label text="Traitées" styleClass="stat-card-title"/>
                        <Label fx:id="traiteesCount" text="0" styleClass="stat-card-value" style="-fx-text-fill: #FEC111;"/>
                    </VBox>
                </HBox>
                <!-- ========== BARRE DE PROGRESSION ========== -->
                <VBox spacing="12"
                      styleClass="surface-panel-soft"
                      style="-fx-padding: 15; -fx-background-radius: 15;"
                      minHeight="80">  <!-- ← FORCE UNE HAUTEUR MINIMALE -->

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊 Progression du traitement" styleClass="title-md" style="-fx-text-fill: #FEC111;"/>
                        <Label fx:id="lblPourcentage" text="0%" style="-fx-text-fill: #FEC111; -fx-font-weight: bold; -fx-font-size: 18px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblStatut" text="0 traitée(s) sur 0" styleClass="text-muted" style="-fx-font-size: 12px;"/>
                    </HBox>

                    <!-- BARRE AVEC HAUTEUR SUFFISANTE -->
                    <ProgressBar fx:id="progressBar"
                                 maxWidth="Infinity"
                                 prefHeight="20"
                                 minHeight="20"
                                 style="-fx-accent: #FEC111; -fx-background-color: #2A2A2A; -fx-background-radius: 10;"/>
                </VBox>
                <!-- ========== SPLITPANE ========== -->
                <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;">
                    <items>
                        <!-- Panneau gauche : Liste des réclamations -->
                        <VBox spacing="12" styleClass="surface-panel" style="-fx-padding: 18; -fx-background-radius: 20;">

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane>
                                    <Circle radius="14" fill="#FEC111"/>
                                    <Label text="📋" style="-fx-font-size: 12px; -fx-text-fill: #1A1A1A;"/>
                                </StackPane>
                                <Label text="Liste des réclamations" styleClass="title-md"/>
                            </HBox>

                            <TableView fx:id="tableReclamation"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="400"
                                       minHeight="300"
                                       styleClass="reponse-table">
                                <columns>
                                    <TableColumn fx:id="colAuteur" text="Auteur" prefWidth="120"/>
                                    <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
                                    <TableColumn fx:id="colDescription" text="Message" prefWidth="200"/>
                                    <TableColumn fx:id="colDetails" text="Détails" prefWidth="120"/>
                                    <TableColumn fx:id="colPrioriteReclamation" text="Priorité" prefWidth="90"/>
                                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="80"/>
                                    <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <!-- Panneau droit : Détails et réponse -->
                        <VBox spacing="15" styleClass="surface-panel" style="-fx-padding: 18; -fx-background-radius: 20;">

                            <!-- Détails de la réclamation -->
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane>
                                    <Circle radius="14" fill="linear-gradient(to bottom right, #FEC111, #E7B541)"/>
                                    <Label text="📝" style="-fx-font-size: 12px; -fx-text-fill: #1A1A1A;"/>
                                </StackPane>
                                <Label text="Détails de la réclamation" styleClass="title-md"/>
                            </HBox>

                            <GridPane hgap="10" vgap="10" styleClass="surface-panel-soft" style="-fx-padding: 15; -fx-background-radius: 12;">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="80" prefWidth="80"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="👤 Auteur:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <Label fx:id="detailAuteurLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #FEC111; -fx-font-weight: bold;"/>

                                <Label text="👤 Utilisateur:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="text-muted"/>
                                <Label fx:id="detailUserLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #FEC111; -fx-font-weight: bold;"/>

                                <Label text="📌 Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="text-muted"/>
                                <Label fx:id="detailTypeLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-muted"/>

                                <Label text="💬 Message:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="text-muted"/>
                                <TextArea fx:id="detailMessageArea" editable="false" prefRowCount="3" wrapText="true" styleClass="text-area" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="🔍 Détails:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="text-muted"/>
                                <Label fx:id="detailInfosLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #FEC111; -fx-font-weight: bold; -fx-wrap-text: true;"/>

                                <Label text="📅 Date:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="text-muted"/>
                                <Label fx:id="detailDateLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="text-muted"/>
                            </GridPane>

                            <!-- Section Traduction du message -->
                            <VBox spacing="8" styleClass="surface-panel-soft" style="-fx-padding: 12; -fx-background-radius: 12;">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <StackPane>
                                        <Circle radius="10" fill="#FEC111"/>
                                        <Label text="🌐" style="-fx-font-size: 10px; -fx-text-fill: #1A1A1A;"/>
                                    </StackPane>
                                    <Label text="Traduction du message" styleClass="title-md" style="-fx-font-size: 13px;"/>
                                </HBox>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <ChoiceBox fx:id="langueCibleChoice" prefWidth="130" styleClass="combo-box"/>
                                    <Button fx:id="traduireMessageButton" text="Traduire" onAction="#traduireMessage" styleClass="btn-primary"/>
                                </HBox>

                                <Label fx:id="traductionMessageLabel" wrapText="true" styleClass="text-muted" style="-fx-font-style: italic;"/>
                            </VBox>

                            <!-- Réponse existante -->
                            <VBox spacing="8" fx:id="reponseExistanteBox" managed="false" visible="false"
                                  styleClass="surface-panel-soft" style="-fx-padding: 12; -fx-background-radius: 12; -fx-border-color: #FEC111; -fx-border-width: 0 0 0 2;">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <StackPane>
                                        <Circle radius="10" fill="#FEC111"/>
                                        <Label text="✅" style="-fx-font-size: 10px; -fx-text-fill: #1A1A1A;"/>
                                    </StackPane>
                                    <Label text="Réponse actuelle" styleClass="title-md" style="-fx-font-size: 13px; -fx-text-fill: #FEC111;"/>
                                </HBox>

                                <TextArea fx:id="reponseExistanteArea" editable="false" prefRowCount="3" wrapText="true" styleClass="text-area"/>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="👤" style="-fx-font-size: 10px;"/>
                                    <Label fx:id="reponseAuteurLabel" text="Admin" style="-fx-text-fill: #FEC111; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                                    <Label fx:id="reponseDateLabel" styleClass="text-muted" style="-fx-font-size: 10px;"/>
                                </HBox>
                            </VBox>

                            <!-- Formulaire de réponse -->
                            <VBox spacing="10">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <StackPane>
                                        <Circle radius="10" fill="#FEC111"/>
                                        <Label text="✏️" style="-fx-font-size: 10px; -fx-text-fill: #1A1A1A;"/>
                                    </StackPane>
                                    <Label text="Répondre" styleClass="title-md" style="-fx-font-size: 13px;"/>
                                </HBox>

                                <TextArea fx:id="reponseField" prefRowCount="4" wrapText="true" promptText="Écrivez votre réponse ici..." styleClass="text-area"/>

                                <Label fx:id="compteurCaracteres" text="0/500 caractères" styleClass="text-muted" style="-fx-font-size: 10px;"/>

                                <HBox spacing="10" alignment="CENTER_RIGHT">
                                    <Button text="📤 Envoyer" onAction="#repondreReclamation" styleClass="btn-primary" style="-fx-background-color: linear-gradient(to right, #22c55e, #16a34a);"/>
                                    <Button text="✏️ Modifier" onAction="#modifierReponse" styleClass="btn-primary"/>
                                    <Button text="🗑️ Supprimer" onAction="#supprimerReponse" styleClass="btn-danger"/>
                                </HBox>
                            </VBox>

                            <!-- Message de statut -->
                            <Label fx:id="statusLabel" text="" wrapText="true" styleClass="info-box" style="-fx-padding: 8 12; -fx-background-radius: 15;"/>
                        </VBox>
                    </items>
                </SplitPane>
            </VBox>
        </ScrollPane>
    </children>
</AnchorPane>