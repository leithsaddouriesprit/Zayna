<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.workshop.controlleurs.leith.MapTrackingController">

    <!-- MAP (remplit tout) -->
    <WebView fx:id="mapView"
             AnchorPane.topAnchor="0.0"
             AnchorPane.bottomAnchor="0.0"
             AnchorPane.leftAnchor="0.0"
             AnchorPane.rightAnchor="0.0"/>

    <!-- OVERLAY bas -->
    <VBox maxWidth="420" spacing="8"
          style="-fx-background-color: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 3);"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.bottomAnchor="20.0">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 22;" text="🚌"/>
            <VBox>
                <Label fx:id="lblTitle" style="-fx-font-size: 16; -fx-font-weight: bold;" text="Bus Tracking"/>
                <Label fx:id="lblSubTitle" style="-fx-font-size: 12; -fx-opacity: 0.75;" text="Informations en temps réel"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <VBox>
                <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Your Son is"/>
                <Label style="-fx-font-size: 12; -fx-opacity: 0.75;" text="On Board"/>
            </VBox>
        </HBox>

        <Separator/>

        <GridPane hgap="12" vgap="6">
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>

            <Label style="-fx-opacity: 0.75;" text="Chauffeur :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblChauffeur" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label style="-fx-opacity: 0.75;" text="Bus :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblBus" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label fx:id="lblEtaTitle" style="-fx-opacity: 0.75;" text="ETA :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblEtaValue" style="-fx-font-weight: bold;" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#recenter" text="Recentrer"/>
            <Button onAction="#close" text="Fermer"/>
        </HBox>

    </VBox>

</AnchorPane>
