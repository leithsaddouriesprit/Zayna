<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.agent.AgentArretsController"
      styleClass="card" spacing="12">
    <stylesheets><URL value="@../app.css"/></stylesheets>
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label text="Arrêts d'un trajet" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Trajet:"/>
        <ComboBox fx:id="comboTrajet" prefWidth="280" promptText="Choisir un trajet" onAction="#onTrajetSelected"/>
    </HBox>

    <HBox spacing="8">
        <Button text="Ajouter arrêt" onAction="#ajouter" fx:id="btnAjouter" disable="true"/>
        <Button text="Modifier" onAction="#modifier" fx:id="btnModifier" disable="true"/>
        <Button text="Supprimer" onAction="#supprimer" fx:id="btnSupprimer" disable="true"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colOrdre" text="Ordre" prefWidth="60"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="colLat" text="Lat" prefWidth="80"/>
            <TableColumn fx:id="colLng" text="Lng" prefWidth="80"/>
            <TableColumn fx:id="colHeure" text="Heure prévue" prefWidth="100"/>
            <TableColumn fx:id="colActions" text="↑ / ↓" prefWidth="80"/>
        </columns>
    </TableView>
    <Label fx:id="lblMessage" text=""/>
</VBox>
