<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.agent.AgentCandidaturesChauffeurController"
      styleClass="card content-area" spacing="12">
    <stylesheets>
        <URL value="@../app.css"/>
        <URL value="@../design/global.css"/>
    </stylesheets>
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label text="Candidatures Chauffeur" styleClass="title-md"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="100"/>
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="100"/>
            <TableColumn fx:id="colAge" text="Âge" prefWidth="50"/>
            <TableColumn fx:id="colExperience" text="Exp (ans)" prefWidth="70"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="140"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="80"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="220"/>
        </columns>
    </TableView>
    <Label fx:id="lblMessage" text=""/>
</VBox>
