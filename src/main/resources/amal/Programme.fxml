<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.amal.ProgrammeController"
      spacing="16" alignment="TOP_CENTER"
      styleClass="card content-area"
      maxWidth="1000">
    <stylesheets>
        <URL value="@../leith/app.css"/>
        <URL value="@../leith/design/global.css"/>
    </stylesheets>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="12" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <VBox spacing="6" alignment="CENTER_LEFT">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ImageView fitHeight="36" fitWidth="36">
                    <Image url="https://img.icons8.com/fluency/48/school.png"/>
                </ImageView>
                <Label text="Gestion des programmes" styleClass="title-md"/>
            </HBox>
            <Label fx:id="lblEcoleNom" text="École : —" styleClass="shell-account"/>
        </VBox>

        <GridPane hgap="16" vgap="10" alignment="CENTER_LEFT">
            <Label text="Nom" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="detail-label"/>
            <TextField fx:id="tfNom" promptText="Nom du programme" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Niveau" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="detail-label"/>
            <TextField fx:id="tfNiveau" promptText="Niveau" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Durée (mois)" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="detail-label"/>
            <TextField fx:id="tfDuree" promptText="Nombre de mois" prefWidth="260" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Description" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="detail-label" style="-fx-alignment: TOP_LEFT;"/>
            <TextArea fx:id="tfDescription" promptText="Description" prefRowCount="3" prefWidth="520" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnAjouter" text="Ajouter" onAction="#ajouterProgramme" styleClass="btn-soft"/>
            <Button text="Modifier" onAction="#modifierProgramme" styleClass="btn-secondary"/>
            <Button text="Supprimer" onAction="#supprimerProgramme" styleClass="btn-soft"/>
            <Button text="Effacer" onAction="#clearFields" styleClass="btn-soft"/>
        </HBox>

        <Label text="Sélectionnez une ligne pour modifier ou supprimer." styleClass="shell-account"/>

        <TableView fx:id="tableProgramme" prefHeight="300" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colNom" text="Programme" prefWidth="220"/>
                <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="120"/>
                <TableColumn fx:id="colDuree" text="Durée" prefWidth="100"/>
            </columns>
        </TableView>

        <HBox styleClass="programme-total-banner" alignment="CENTER_LEFT" maxWidth="Infinity">
            <Label fx:id="lblTotalProgrammes" text="Total programmes : 0"/>
        </HBox>
    </VBox>
</VBox>
