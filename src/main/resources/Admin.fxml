<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="640.0" spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.workshop.controlleurs.talel.AdminController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <!-- En-tête avec titre et bouton de déconnexion -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestion des Utilisateurs" HBox.hgrow="ALWAYS" />
        <Button fx:id="logoutButton" onAction="#handleLogoutButton" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" text="Déconnexion">
            <graphic>
                <Label text="🚪" />
            </graphic>
        </Button>
    </HBox>

    <!-- Barre d'outils -->
    <ToolBar>
        <items>
            <Button fx:id="addButton" onAction="#handleAddButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Ajouter">
                <graphic>
                    <Label text="➕" />
                </graphic>
            </Button>
            <Button fx:id="editButton" onAction="#handleEditButton" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Modifier">
                <graphic>
                    <Label text="✏️" />
                </graphic>
            </Button>
            <Button fx:id="deleteButton" onAction="#handleDeleteButton" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Supprimer">
                <graphic>
                    <Label text="🗑️" />
                </graphic>
            </Button>
            <Separator orientation="VERTICAL" />
            <Button fx:id="refreshButton" onAction="#handleRefreshButton" text="Actualiser">
                <graphic>
                    <Label text="🔄" />
                </graphic>
            </Button>
        </items>
    </ToolBar>

    <!-- Panneau de recherche et filtres -->
    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets bottom="10" top="10" />
        </padding>

        <Label text="Rechercher:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="searchField" onKeyReleased="#handleSearchField" promptText="Nom, email, ID ou catégorie..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Catégorie:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="categoryFilterCombo" onAction="#handleCategoryFilter" promptText="Toutes" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Button fx:id="clearSearchButton" onAction="#handleClearSearchButton" text="Effacer les filtres" GridPane.columnIndex="4" GridPane.rowIndex="0">
            <graphic>
                <Label text="❌" />
            </graphic>
        </Button>

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
            <ColumnConstraints halignment="RIGHT" />
            <ColumnConstraints minWidth="150" />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <!-- Tableau des utilisateurs -->
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50" text="ID" />
            <TableColumn fx:id="colNom" prefWidth="150" text="Nom" />
            <TableColumn fx:id="colEmail" prefWidth="250" text="Email" />
            <TableColumn fx:id="colPassword" prefWidth="100" text="Mot de passe" />
            <TableColumn fx:id="colCategorie" prefWidth="120" text="Catégorie" />
        </columns>
    </TableView>

    <!-- Statistiques -->
    <FlowPane alignment="CENTER" hgap="15" vgap="5">
        <padding>
            <Insets bottom="10" top="10" />
        </padding>
        <Label fx:id="totalUsersLabel" style="-fx-font-weight: bold;" text="Total: 0" />
        <Label fx:id="adminCountLabel" style="-fx-text-fill: #9C27B0; -fx-font-weight: bold;" text="Admins: 0" />
        <Label fx:id="parentCountLabel" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="Parents: 0" />
        <Label fx:id="maitresseCountLabel" style="-fx-text-fill: #FF9800; -fx-font-weight: bold;" text="Maîtresses: 0" />
        <Label fx:id="responsableEcoleCountLabel" style="-fx-text-fill: #2196F3; -fx-font-weight: bold;" text="Responsables: 0" />
        <Label fx:id="chauffeurCountLabel" style="-fx-text-fill: #F44336; -fx-font-weight: bold;" text="Chauffeurs: 0" />
    </FlowPane>

    <!-- Formulaire d'ajout/modification -->
    <GridPane fx:id="userForm" hgap="10" managed="false" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #f9f9f9;" vgap="10" visible="false">

        <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="idField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nom:*" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNom" promptText="Nom complet" GridPane.columnIndex="1" GridPane.rowIndex="1" />  <!-- CHANGÉ: nomField → txtNom -->

        <Label text="Email:*" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtEmail" promptText="exemple@Zayna.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />  <!-- CHANGÉ: emailField → txtEmail -->

        <Label text="Mot de passe:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <PasswordField fx:id="txtMotDePasse" promptText="Mot de passe (min. 6 caractères, max. 30)" GridPane.columnIndex="1" GridPane.rowIndex="3" />  <!-- CHANGÉ: passwordField → txtMotDePasse -->

        <Label text="Catégorie:*" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <ComboBox fx:id="categorieCombo" promptText="Sélectionner une catégorie" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <HBox alignment="CENTER" spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
            <padding>
                <Insets top="10" />
            </padding>
            <Button fx:id="saveButton" onAction="#handleSaveButton" prefWidth="100" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Sauvegarder" />
            <Button fx:id="cancelButton" onAction="#handleCancelButton" prefWidth="100" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" text="Annuler" />
        </HBox>

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="100" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <!-- Barre de statut -->
    <Label fx:id="statusLabel" style="-fx-font-style: italic;" />
</VBox>