<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.CreationCompteController">

    <children>
        <TextField fx:id="nomField"
                   layoutX="180.0" layoutY="120.0"
                   prefWidth="240.0"
                   promptText="Nom complet" />

        <TextField fx:id="emailField"
                   layoutX="180.0" layoutY="170.0"
                   prefWidth="240.0"
                   promptText="Email" />

        <TextField fx:id="motDePasseField"
                   layoutX="180.0" layoutY="220.0"
                   prefWidth="240.0"
                   promptText="Mot de passe" />

        <TextField fx:id="categoriesField"
                   layoutX="180.0" layoutY="270.0"
                   prefWidth="240.0"
                   promptText="Catégorie (ADMIN, CLIENT, INVITE)" />

        <Button fx:id="btnCreerCompte"
                layoutX="240.0" layoutY="320.0"
                prefWidth="140.0"
                text="Créer mon compte"
                onAction="#creerCompte" />
    </children>
</AnchorPane>
