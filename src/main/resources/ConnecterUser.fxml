<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: linear-gradient(to bottom, #667eea, #764ba2);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.workshop.controlleurs.talel.ConnecterController">

    <VBox alignment="CENTER" maxHeight="713.0" maxWidth="500.0" prefHeight="629.0" prefWidth="500.0" spacing="20">
        <padding>
            <Insets bottom="20.0" />
        </padding>

        <!-- Logo et titre -->
        <VBox alignment="CENTER" prefHeight="149.0" prefWidth="500.0" spacing="10">
            <Label prefHeight="67.0" prefWidth="60.0" style="-fx-font-size: 60px;" text="🚌" />
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Zayna" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="Gestion des transports scolaires" />
        </VBox>

        <!-- Panneau de connexion -->
        <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="454.0" prefWidth="314.0" spacing="20" style="-fx-background-color: white; -fx-background-radius: 10;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" />
            </padding>

            <!-- CORRECTION 1: Message d'erreur - avec managed="true" et wrapText="true" -->
            <Label fx:id="loginErrorLabel" wrapText="true" managed="true" style="-fx-padding: 10; -fx-background-radius: 5;" visible="false" />

            <Label alignment="CENTER" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="CONNEXION" />

            <!-- Champ Email -->
            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Email" />
                <TextField fx:id="emailField" promptText="exemple@domaine.com" style="-fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-padding: 10;" />
            </VBox>

            <!-- Champ Mot de passe -->
            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Mot de passe" />
                <PasswordField fx:id="passwordField" promptText="••••••••" style="-fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-padding: 10;" />
            </VBox>

            <!-- Bouton de connexion -->
            <StackPane>
                <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="45" style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="SE CONNECTER" />
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="25" maxWidth="25" visible="false" />
            </StackPane>

            <!-- CORRECTION 2: Lien mot de passe oublié (déplacé après le bouton) -->
            <Hyperlink onAction="#handleForgotPassword" style="-fx-text-fill: #2196F3; -fx-alignment: CENTER;" text="Mot de passe oublié ?" />

            <!-- Liens d'inscription -->
            <VBox alignment="CENTER" spacing="10">
                <Label style="-fx-text-fill: #718096; -fx-font-weight: bold;" text="Vous êtes ?" />

                <HBox alignment="CENTER" spacing="15">
                    <Hyperlink onAction="#handleInscriptionParent" style="-fx-text-fill: #667eea; -fx-font-weight: bold;" text="👪 Parent" />
                    <Label style="-fx-text-fill: #ccc;" text="|" />
                    <Hyperlink onAction="#handleInscriptionChauffeur" style="-fx-text-fill: #667eea; -fx-font-weight: bold;" text="🚗 Chauffeur" />
                </HBox>

                <HBox alignment="CENTER" spacing="15">
                    <Hyperlink onAction="#handleInscriptionMaitresse" style="-fx-text-fill: #667eea; -fx-font-weight: bold;" text="👩‍🏫 Maîtresse" />
                    <Label style="-fx-text-fill: #ccc;" text="|" />
                    <Hyperlink onAction="#handleInscriptionResponsable" style="-fx-text-fill: #667eea; -fx-font-weight: bold;" text="🏫 Responsable École" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>