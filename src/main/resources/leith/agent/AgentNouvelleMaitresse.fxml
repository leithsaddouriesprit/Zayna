<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.workshop.controlleurs.leith.agent.AgentNouvelleMaitresseController"
      styleClass="card content-area" spacing="12">
    <stylesheets>
        <URL value="@../app.css"/>
        <URL value="@../design/global.css"/>
    </stylesheets>
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label text="Nouvelle maîtresse" styleClass="title-md"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
        </columnConstraints>
        <Label text="Nom *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fieldNom" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Prénom *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="fieldPrenom" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Email *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="fieldEmail" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Mot de passe *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <PasswordField fx:id="fieldPassword" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Bus (optionnel)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboBus" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="8">
        <Button text="Enregistrer" onAction="#onSave" styleClass="btn-primary"/>
        <Button text="Réinitialiser" onAction="#onReset" styleClass="btn-secondary"/>
    </HBox>
    <Label fx:id="lblMessage" wrapText="true"/>
</VBox>
