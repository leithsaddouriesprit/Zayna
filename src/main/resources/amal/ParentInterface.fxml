<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.workshop.controlleurs.amal.ParentController"
           styleClass="root" maxWidth="Infinity" maxHeight="Infinity">
    <stylesheets>
        <URL value="@../leith/app.css"/>
        <URL value="@../leith/design/global.css"/>
    </stylesheets>

    <VBox fx:id="mainPane" spacing="16" styleClass="card content-area" maxWidth="Infinity" maxHeight="Infinity">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <Label text="Demande transport" styleClass="title-md"/>

        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <VBox spacing="10" prefWidth="300" minWidth="260">
                <Label text="Écoles" styleClass="detail-label"/>
                <ListView fx:id="listViewEcoles" VBox.vgrow="ALWAYS" minHeight="280" styleClass="table-view"/>
            </VBox>

            <VBox spacing="14" HBox.hgrow="ALWAYS" minWidth="400">
                <VBox fx:id="detailsContainer" visible="false" managed="false" spacing="10">
                    <Label fx:id="lblNomEcole" text="—" styleClass="title-sm"/>

                    <GridPane hgap="10" vgap="8">
                        <Label text="Adresse" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="detail-label"/>
                        <Label fx:id="lblAdresseEcole" text="—" wrapText="true" maxWidth="480" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="detail-value"/>

                        <Label text="Coordonnées" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="detail-label"/>
                        <Label fx:id="lblCoordsEcole" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="detail-value"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnInscrire" text="S'inscrire" onAction="#inscrireEnfant" styleClass="btn-primary"/>
                        <Button fx:id="btnVoirTrajets" text="Trajets" onAction="#voirTrajets" styleClass="btn-secondary" disable="true"/>
                        <Button fx:id="btnCalendrier" text="Calendrier" onAction="#voirCalendrier" styleClass="btn-soft"/>
                        <Button fx:id="btnMeteo" text="Météo" onAction="#voirMeteo" styleClass="btn-soft"/>
                    </HBox>
                </VBox>

                <VBox fx:id="messageContainer" spacing="8" alignment="CENTER" minHeight="120" styleClass="shell-account">
                    <Label text="Sélectionnez une école pour afficher les programmes et les trajets." wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <VBox fx:id="programmesContainer" visible="false" managed="false" spacing="10" VBox.vgrow="ALWAYS">
                    <Label text="Programmes" styleClass="title-sm"/>
                    <ScrollPane fitToWidth="true" styleClass="content-area" VBox.vgrow="ALWAYS" minHeight="200">
                        <FlowPane fx:id="programmesFlowPane" hgap="14" vgap="14"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="trajetsPane" visible="false" managed="false" spacing="12" styleClass="card content-area" maxWidth="Infinity" maxHeight="Infinity">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Retour" onAction="#retourDemandeTransport" styleClass="btn-soft"/>
            <Label fx:id="lblTrajetsEcole" text="Trajets" styleClass="title-sm"/>
        </HBox>
        <ScrollPane fx:id="trajetsScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-area" minHeight="320"/>
    </VBox>
</StackPane>
